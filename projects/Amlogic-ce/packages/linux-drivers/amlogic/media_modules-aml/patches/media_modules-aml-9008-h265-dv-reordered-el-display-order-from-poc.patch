+#ifdef CONFIG_AMLOGIC_MEDIA_ENHANCEMENT_DOLBYVISION
+/*
+ * Dual layer: the random access point a new picture belongs to. A picture
+ * of POC p after the IRAP of access unit A, POC P and L leading pictures is
+ * shown at place A + L - P + p: the leading pictures (RASL/RADL) are shown
+ * before the IRAP (at A, A + 1, ... in their output order), and every access
+ * unit holds one picture of each layer.
+ * The place does not depend on how many pictures were decoded, shown or
+ * dropped, which after a seek differs between the layers.
+ */
+static void dv_note_picture(struct hevc_state_s *hevc, struct PIC_s *pic)
+{
+	int t = hevc->m_nalUnitType;
+
+	pic->dv_irap = -1;
+	pic->dv_lead = 0;
+	if (t >= NAL_UNIT_CODED_SLICE_BLA && t <= NAL_UNIT_CODED_SLICE_CRA) {
+		int i = hevc->dv_irap_n++ & 7;
+
+		hevc->dv_irap[i].au = pic->dv_pair_id;
+		hevc->dv_irap[i].poc = hevc->curr_POC;
+		hevc->dv_irap[i].lead = 0;
+		hevc->dv_irap[i].lead_out = 0;
+	}
+	/* before the first random access point: its place is not known */
+	if (!hevc->dv_irap_n)
+		return;
+	pic->dv_irap = (hevc->dv_irap_n - 1) & 7;
+	if (t >= NAL_UNIT_CODED_SLICE_RADL_N && t <= NAL_UNIT_CODED_SLICE_TFD &&
+		hevc->curr_POC < hevc->dv_irap[pic->dv_irap].poc) {
+		hevc->dv_irap[pic->dv_irap].lead++;
+		pic->dv_lead = 1;
+	}
+}
+#endif
