+			hevc->dv_el_out_pending = 0;
+			if (hevc->dec_result == DEC_RESULT_DV_DONE)
+				hevc_el_output_decoded(hevc);
+		}
+#endif
 
 		if (is_log_enable(hevc))
 			add_log(hevc,
@@ -19388,6 +19437,7 @@
