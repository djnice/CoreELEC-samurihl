+/*
+ * HDR10 (also for the Dolby Vision profile 8.1 base layer), HLG or SDR: the
+ * source format when the decoder filled it in, else the transfer of the
+ * signal type (the source format is often left empty on the way to display).
+ */
+static enum vframe_signal_fmt_e amvideocap_frame_hdr(struct vframe_s *vf)
+{
+	switch (get_vframe_src_fmt(vf)) {
+	case VFRAME_SIGNAL_FMT_HDR10:
+	case VFRAME_SIGNAL_FMT_HDR10PLUS:
+	case VFRAME_SIGNAL_FMT_HDR10PRIME:
+	case VFRAME_SIGNAL_FMT_DOVI:
+	case VFRAME_SIGNAL_FMT_DOVI_LL:
+		return VFRAME_SIGNAL_FMT_HDR10;
+	case VFRAME_SIGNAL_FMT_HLG:
+		return VFRAME_SIGNAL_FMT_HLG;
+	default:
+		break;
+	}
+	if (amvideocap_has_colour(vf)) {
+		switch ((vf->signal_type >> 8) & 0xff) {
+		case 16:	/* SMPTE ST 2084 */
+			return VFRAME_SIGNAL_FMT_HDR10;
+		case 18:	/* ARIB STD-B67 */
+			return VFRAME_SIGNAL_FMT_HLG;
+		default:
+			break;
+		}
+	}
+	return VFRAME_SIGNAL_FMT_SDR;
+}
 
