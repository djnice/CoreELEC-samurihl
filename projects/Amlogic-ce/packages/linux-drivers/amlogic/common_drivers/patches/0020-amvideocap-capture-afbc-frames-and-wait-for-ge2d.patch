+static void amvideocap_snapshot(struct amvideocap_src *s, struct vframe_s *vf)
+{
+	int i;
+
+	s->vf = *vf;
+	s->nplanes = 0;
+	if (vf->canvas0Addr == (u32)-1) {
+		for (i = 0; i < vf->plane_num && i < 3; i++) {
+			const struct canvas_config_s *c = &vf->canvas0_config[i];
