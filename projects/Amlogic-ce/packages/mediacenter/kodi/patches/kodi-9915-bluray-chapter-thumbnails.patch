   return -1;
 }
 
+bool CVideoPlayer::GetChapterThumbSource(int chapterIdx, std::string& path, int64_t& posMs) const
+{
+  std::unique_lock lock(m_StateSection);
+  if (chapterIdx <= 0 || chapterIdx > static_cast<int>(m_State.chapterClips.size()))
+    return false;
+  const auto& [clip, clipMs] = m_State.chapterClips[chapterIdx - 1];
+  if (clip.empty() || clipMs < 0)
+    return false;
+
+  // index.bdmv (folder), the .iso, or a bluray:// path of either
+  std::string disc{m_item.GetPath()};
+  if (URIUtils::IsBlurayPath(disc))
+    disc = URIUtils::GetDiscFile(disc);
+  const std::string m2ts{clip + ".m2ts"};
+  if (URIUtils::IsDiscImage(disc))
+  {
+    CURL url("udf://");
+    url.SetHostName(disc);
+    url.SetFileName(URIUtils::AddFileToFolder("BDMV", "STREAM", m2ts));
+    path = url.Get();
+  }
+  else if (URIUtils::IsBDFile(disc))
+    path = URIUtils::AddFileToFolder(URIUtils::GetDirectory(disc), "STREAM", m2ts);
+  else
+    return false;
+  posMs = clipMs;
+  return true;
+}
