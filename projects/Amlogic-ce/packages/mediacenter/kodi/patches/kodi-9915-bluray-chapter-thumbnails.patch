diff --git a/xbmc/cores/VideoPlayer/DVDFileInfo.cpp b/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
index ae71ee3e85..e900fc1891 100644
--- a/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
+++ b/xbmc/cores/VideoPlayer/DVDFileInfo.cpp
@@ -115,8 +115,13 @@ bool CDVDFileInfo::SeekAndDecodeFirstPicture(CDVDDemux& demuxer,
 
   CDVDVideoCodec::VCReturn iDecoderState = CDVDVideoCodec::VC_NONE;
 
-  // num streams * 160 frames, should get a valid frame, if not abort.
-  for (int attemptsLeft = demuxer.GetNrOfStreams() * 160; attemptsLeft >= 0; attemptsLeft--)
+  // Up to 400 video packets (more than a GOP) to the first picture. Only the video counts: a UHD
+  // Blu-ray clip carries a dozen other streams, TrueHD audio alone about 1200 packets a second,
+  // which used up a limit over all packets before the first keyframe after a seek. The total
+  // stays bounded for a stream that never yields a picture.
+  int videoLeft = 400;
+  for (int attemptsLeft = std::max(demuxer.GetNrOfStreams() * 160, 60000);
+       attemptsLeft >= 0 && videoLeft >= 0; attemptsLeft--)
   {
     DemuxPacket* pPacket = demuxer.Read();
     packetsTried++;
@@ -129,6 +134,7 @@ bool CDVDFileInfo::SeekAndDecodeFirstPicture(CDVDDemux& demuxer,
       CDVDDemuxUtils::FreeDemuxPacket(pPacket);
       continue;
     }
+    videoLeft--;
 
     codec.AddData(*pPacket);
     CDVDDemuxUtils::FreeDemuxPacket(pPacket);
