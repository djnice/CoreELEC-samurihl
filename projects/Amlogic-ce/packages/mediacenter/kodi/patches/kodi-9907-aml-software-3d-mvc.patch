+
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <set>
+#include <thread>
+#include <vector>
+
+class CDVDStreamInfo;
+struct Edge264Decoder;
+struct Edge264Frame;
+
+/*!
+ * \brief Software 3D MVC decoding for Amlogic SoCs.
+ *
+ * The hardware MVC decoder corrupts the dependent view on some discs, so the
+ * stream is decoded with edge264-mvc on the CPU instead. Both views are
+ * composed into one picture (frame packing at full resolution, or a mono /
+ * half resolution side-by-side / top-bottom picture) in buffers of the
+ * mvcout kernel module, which hands them to the video layer through the
+ * usual "... amlvideo amvideo" vfm chain. CAMLCodec keeps pacing the frames
+ * through the amlvideo v4l device as for the hardware decoders.
+ */
+class CAMLMvc
+{
+public:
+  enum class Mode
+  {
+    FramePacked, // left, 45 lines of active space, right (1920x2205 for 1080p)
+    Left,
+    Right,
+    SideBySide, // half width each
+    TopBottom, // half height each
+  };
+
+  CAMLMvc() = default;
+  ~CAMLMvc();
+
+  //! The mvcout module is loaded and Kodi was built with edge264
+  static bool IsSupported();
+  //! Decode 3D MVC in software: always on S5, a setting on the other SoCs
+  static bool IsEnabled();
+
+  bool Open(const CDVDStreamInfo& hints);
+  void Close();
+
+  //! Queue one access unit (Annex B, both views); false: queue full, retry
+  bool AddData(const uint8_t* data, size_t size, double pts);
+  //! Seek: drop everything queued or decoded, returns once the thread is idle
+  void Reset();
+  //! End of stream: output the pictures the decoder still holds
+  void Drain();
+  bool IsDrained();
+  bool IsFull();
+  //! input queue fill in percent, the stream buffer level of the hardware decoders
+  float GetLevel();
+
+  void SetMode(Mode mode) { m_mode = mode; }
+  //! the base view is the right eye ("block_rl")
+  void SetSwapViews(bool swap) { m_swap = swap; }
+  Mode GetMode() const { return m_mode; }
+  double GetFrameDuration() const { return m_frameDuration; }
+
+private:
+  struct Packet
+  {
+    std::vector<uint8_t> data;
+    double pts;
+  };
+
+  void Process();
+  void DecodeUnits(const uint8_t* data, size_t size);
+  void OutputFrames(bool drain);
+  bool OutputFrame(const Edge264Frame& frame);
+  bool ResetPending();
+  void DoReset();
+
+  int m_fd{-1};
+  std::vector<uint8_t*> m_maps;
+  uint32_t m_width{0};
+  uint32_t m_height{0};
+  uint32_t m_stride{0};
+  uint32_t m_size{0};
+
+  Edge264Decoder* m_decoder{nullptr};
+  std::vector<uint8_t> m_headers; // parameter sets from the extradata
+
+  std::thread m_thread;
+  std::mutex m_mutex;
+  std::condition_variable m_cv;
+  std::condition_variable m_cvIdle;
+  std::deque<Packet> m_queue;
+  size_t m_queueBytes{0};
+  bool m_stop{false};
+  bool m_drainReq{false};
+  bool m_drained{false};
+  uint64_t m_resetReq{0};
+  uint64_t m_resetDone{0};
+
+  std::atomic<Mode> m_mode{Mode::FramePacked};
+  std::atomic<bool> m_swap{false};
+  std::multiset<double> m_pts; // decode thread only
+  double m_lastPts;
+  double m_frameDuration{41708.0};
+  uint32_t m_duration96{4004};
+  uint64_t m_frames{0};
+  uint64_t m_badNals{0};
+};
