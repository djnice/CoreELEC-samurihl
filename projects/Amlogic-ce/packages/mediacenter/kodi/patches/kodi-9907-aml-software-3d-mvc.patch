+
+#ifdef HAS_EDGE264
+#include <edge264.h>
+#endif
+
+namespace
+{
+constexpr int NUM_BUFFERS = 10;
+constexpr int VIEW_W = 1920;
+constexpr int VIEW_H = 1080;
+constexpr int FP_GAP = 45; // active space of 1080p frame packing
+// the decoder runs well ahead of realtime and 10 composed pictures wait in
+// mvcout: a short input queue, since everything queued at the end of a file
+// plays out in one player drain step, which gives up after 1.5 s of no progress
+constexpr size_t MAX_QUEUE_PACKETS = 8;
+constexpr size_t MAX_QUEUE_BYTES = 16 * 1024 * 1024;
+constexpr size_t MAX_PENDING_PTS = 32;
+
+// the S5 video layer reads packed 4:2:2 as U Y V Y
+enum
+{
+  B_U = 0,
+  B_Y0 = 1,
+  B_V = 2,
+  B_Y1 = 3
+};
+
+struct View
+{
+  const uint8_t* y;
+  const uint8_t* u;
+  const uint8_t* v;
+  int sy;
+  int sc;
+};
+
+inline uint8_t Avg2(int a, int b)
+{
+  return static_cast<uint8_t>((a + b + 1) >> 1);
+}
+
+/*
+ * One view at full size into packed 4:2:2 lines. 4:2:0 -> 4:2:2 chroma for
+ * luma row r (chroma between luma rows 2k and 2k+1): 3/4 of chroma row k and
+ * 1/4 of row k-1 (even r) or k+1 (odd r).
+ */
+void ComposeFull(uint8_t* dst, int stride, const View& vw)
+{
+  const int hc = VIEW_H / 2;
+  uint8_t line[VIEW_W * 2];
+
+  for (int r = 0; r < VIEW_H; r++)
+  {
+    const int k = r >> 1;
+    const int n = std::clamp((r & 1) ? k + 1 : k - 1, 0, hc - 1);
+    const uint8_t* y = vw.y + r * vw.sy;
+    const uint8_t* u0 = vw.u + k * vw.sc;
+    const uint8_t* u1 = vw.u + n * vw.sc;
+    const uint8_t* v0 = vw.v + k * vw.sc;
+    const uint8_t* v1 = vw.v + n * vw.sc;
+    uint8_t* d = line;
+
+    for (int x = 0; x < VIEW_W / 2; x++, d += 4)
+    {
+      d[B_Y0] = y[2 * x];
+      d[B_Y1] = y[2 * x + 1];
+      d[B_U] = static_cast<uint8_t>((3 * u0[x] + u1[x] + 2) >> 2);
+      d[B_V] = static_cast<uint8_t>((3 * v0[x] + v1[x] + 2) >> 2);
+    }
+    // one sequential write per line into the write-combined buffer
+    memcpy(dst + r * stride, line, sizeof(line));
+  }
+}
+
+//! One view at half width (x0 = 0 or VIEW_W / 2) of a side-by-side picture
+void ComposeHalfWidth(uint8_t* dst, int stride, int x0, const View& vw)
+{
+  const int hc = VIEW_H / 2;
+  uint8_t line[VIEW_W];
+
+  for (int r = 0; r < VIEW_H; r++)
+  {
+    const int k = r >> 1;
+    const int n = std::clamp((r & 1) ? k + 1 : k - 1, 0, hc - 1);
+    const uint8_t* y = vw.y + r * vw.sy;
+    const uint8_t* u0 = vw.u + k * vw.sc;
+    const uint8_t* u1 = vw.u + n * vw.sc;
+    const uint8_t* v0 = vw.v + k * vw.sc;
+    const uint8_t* v1 = vw.v + n * vw.sc;
+    uint8_t* d = line;
+
+    // output pixel pair i covers source luma 4i..4i+3 and chroma 2i, 2i+1
+    for (int i = 0; i < VIEW_W / 4; i++, d += 4)
+    {
+      const int c = 2 * i;
+      d[B_Y0] = Avg2(y[4 * i], y[4 * i + 1]);
+      d[B_Y1] = Avg2(y[4 * i + 2], y[4 * i + 3]);
+      d[B_U] = static_cast<uint8_t>((3 * (u0[c] + u0[c + 1]) + u1[c] + u1[c + 1] + 4) >> 3);
+      d[B_V] = static_cast<uint8_t>((3 * (v0[c] + v0[c + 1]) + v1[c] + v1[c + 1] + 4) >> 3);
+    }
+    memcpy(dst + r * stride + x0 * 2, line, sizeof(line));
+  }
+}
+
+//! One view at half height into VIEW_H / 2 lines of a top-bottom picture
+void ComposeHalfHeight(uint8_t* dst, int stride, const View& vw)
+{
+  uint8_t line[VIEW_W * 2];
+
+  // output row r covers luma rows 2r, 2r+1 and exactly chroma row r
+  for (int r = 0; r < VIEW_H / 2; r++)
+  {
+    const uint8_t* ya = vw.y + 2 * r * vw.sy;
+    const uint8_t* yb = ya + vw.sy;
+    const uint8_t* u = vw.u + r * vw.sc;
+    const uint8_t* v = vw.v + r * vw.sc;
+    uint8_t* d = line;
+
+    for (int x = 0; x < VIEW_W / 2; x++, d += 4)
+    {
+      d[B_Y0] = Avg2(ya[2 * x], yb[2 * x]);
+      d[B_Y1] = Avg2(ya[2 * x + 1], yb[2 * x + 1]);
+      d[B_U] = u[x];
+      d[B_V] = v[x];
+    }
+    memcpy(dst + r * stride, line, sizeof(line));
+  }
+}
+
+void Black(uint8_t* dst, int stride, int rows)
+{
+  uint8_t line[VIEW_W * 2];
+
+  for (int x = 0; x < VIEW_W / 2; x++)
+  {
+    line[4 * x + B_Y0] = line[4 * x + B_Y1] = 16;
+    line[4 * x + B_U] = line[4 * x + B_V] = 128;
+  }
+  for (int r = 0; r < rows; r++)
+    memcpy(dst + r * stride, line, sizeof(line));
+}
+
+//! Parameter sets out of the (Annex B) extradata, so a reset can resend them
+std::vector<uint8_t> AnnexBHeaders(const uint8_t* data, size_t size)
+{
+  if (size >= 4 && data[0] == 0 && data[1] == 0 &&
+      (data[2] == 1 || (data[2] == 0 && data[3] == 1)))
+    return std::vector<uint8_t>(data, data + size);
+  return {};
+}
+} // namespace
+
+CAMLMvc::~CAMLMvc()
+{
+  Close();
+}
+
+bool CAMLMvc::IsSupported()
+{
+#ifdef HAS_EDGE264
+  return access(MVCOUT_DEV, F_OK) == 0;
+#else
+  return false;
+#endif
+}
+
+bool CAMLMvc::IsEnabled()
+{
+  if (!IsSupported())
+    return false;
+  if (aml_get_cpufamily_id() == AML_S5)
+    return true;
+  return CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
+      CSettings::SETTING_COREELEC_AMLOGIC_MVC_SOFTWARE);
+}
+
+bool CAMLMvc::Open(const CDVDStreamInfo& hints)
+{
+#ifdef HAS_EDGE264
+  if (hints.width != VIEW_W || (hints.height != VIEW_H && hints.height != 1088))
+  {
+    CLog::Log(LOGWARNING, "CAMLMvc::Open - unsupported size {}x{}", hints.width, hints.height);
+    return false;
+  }
+
+  m_fd = open(MVCOUT_DEV, O_RDWR | O_CLOEXEC);
+  if (m_fd < 0)
+  {
+    CLog::Log(LOGERROR, "CAMLMvc::Open - cannot open {}: {}", MVCOUT_DEV, strerror(errno));
+    return false;
+  }
+
+  // one allocation for every mode: frame packing is the largest picture
+  mvcout_alloc a{};
+  a.width = VIEW_W;
+  a.height = 2 * VIEW_H + FP_GAP;
+  a.format = MVCOUT_FMT_YUV422;
+  a.count = NUM_BUFFERS;
+  if (ioctl(m_fd, MVCOUT_IOC_ALLOC, &a) < 0)
+  {
+    CLog::Log(LOGERROR, "CAMLMvc::Open - buffer allocation failed: {}", strerror(errno));
+    Close();
+    return false;
+  }
+  m_width = a.width;
+  m_height = a.height;
+  m_stride = a.stride;
+  m_size = a.size;
+  for (int i = 0; i < NUM_BUFFERS; i++)
+  {
+    void* p = mmap(nullptr, a.size, PROT_READ | PROT_WRITE, MAP_SHARED, m_fd,
+                   static_cast<off_t>(i) * a.map_size);
+    if (p == MAP_FAILED)
+    {
+      CLog::Log(LOGERROR, "CAMLMvc::Open - mmap failed: {}", strerror(errno));
+      Close();
+      return false;
+    }
+    m_maps.push_back(static_cast<uint8_t*>(p));
+  }
+
+  if (hints.fpsrate > 0 && hints.fpsscale > 0)
+    m_frameDuration = static_cast<double>(DVD_TIME_BASE) * hints.fpsscale / hints.fpsrate;
+  else
+    m_frameDuration = DVD_TIME_BASE * 1001.0 / 24000.0;
+  m_duration96 = static_cast<uint32_t>(m_frameDuration * 96000.0 / DVD_TIME_BASE + 0.5);
+
+  m_headers = AnnexBHeaders(hints.extradata.GetData(), hints.extradata.GetSize());
+
+  m_decoder = edge264_alloc(-1, nullptr, nullptr, 0, nullptr, nullptr, nullptr);
+  if (!m_decoder)
+  {
+    CLog::Log(LOGERROR, "CAMLMvc::Open - edge264_alloc failed");
+    Close();
+    return false;
+  }
+
+  if (ioctl(m_fd, MVCOUT_IOC_START) < 0)
+  {
+    CLog::Log(LOGERROR, "CAMLMvc::Open - start failed: {}", strerror(errno));
+    Close();
+    return false;
+  }
+
+  m_stop = false;
+  m_drainReq = m_drained = false;
+  m_resetReq = m_resetDone = 0;
+  m_lastPts = DVD_NOPTS_VALUE;
+  m_pts.clear();
+  m_frames = m_badNals = 0;
+  m_thread = std::thread(&CAMLMvc::Process, this);
+
+  CLog::Log(LOGINFO,
+            "CAMLMvc::Open - software MVC decoding, {} buffers of {} KiB, frame {:.3f} ms, "
+            "{} bytes of parameter sets",
+            NUM_BUFFERS, a.map_size >> 10, m_frameDuration / 1000.0, m_headers.size());
+  return true;
+#else
+  return false;
+#endif
+}
+
+void CAMLMvc::Close()
+{
+  if (m_thread.joinable())
+  {
+    {
+      std::unique_lock<std::mutex> lock(m_mutex);
+      m_stop = true;
+    }
+    m_cv.notify_all();
+    m_thread.join();
+    CLog::Log(LOGINFO, "CAMLMvc::Close - {} frames, {} bad NAL units", m_frames, m_badNals);
+  }
+#ifdef HAS_EDGE264
+  if (m_decoder)
+    edge264_free(&m_decoder);
+#endif
+  m_decoder = nullptr;
+  if (m_fd >= 0)
+    ioctl(m_fd, MVCOUT_IOC_STOP);
+  for (uint8_t* p : m_maps)
+    munmap(p, m_size);
+  m_maps.clear();
+  if (m_fd >= 0)
+    close(m_fd);
+  m_fd = -1;
+  m_queue.clear();
+  m_queueBytes = 0;
+}
+
+bool CAMLMvc::AddData(const uint8_t* data, size_t size, double pts)
+{
+  std::unique_lock<std::mutex> lock(m_mutex);
+  if (m_queue.size() >= MAX_QUEUE_PACKETS || m_queueBytes + size > MAX_QUEUE_BYTES)
+    return false;
+  m_queue.push_back({std::vector<uint8_t>(data, data + size), pts});
+  m_queueBytes += size;
+  m_drainReq = m_drained = false;
+  lock.unlock();
+  m_cv.notify_all();
+  return true;
+}
+
+bool CAMLMvc::IsFull()
+{
+  std::unique_lock<std::mutex> lock(m_mutex);
+  return m_queue.size() >= MAX_QUEUE_PACKETS || m_queueBytes >= MAX_QUEUE_BYTES / 2;
+}
+
+float CAMLMvc::GetLevel()
+{
+  std::unique_lock<std::mutex> lock(m_mutex);
+  const float packets = static_cast<float>(m_queue.size()) / MAX_QUEUE_PACKETS;
+  const float bytes = static_cast<float>(m_queueBytes) / (MAX_QUEUE_BYTES / 2);
+  return std::min(100.0f, 100.0f * std::max(packets, bytes));
+}
+
+void CAMLMvc::Reset()
+{
+  std::unique_lock<std::mutex> lock(m_mutex);
+  m_queue.clear();
+  m_queueBytes = 0;
+  m_drainReq = m_drained = false;
+  const uint64_t req = ++m_resetReq;
+  m_cv.notify_all();
+  // the thread may sit in a decode call for a few ms, never much longer
+  if (!m_cvIdle.wait_for(lock, std::chrono::seconds(2), [&] { return m_resetDone >= req || !m_thread.joinable(); }))
+    CLog::Log(LOGWARNING, "CAMLMvc::Reset - decoder thread did not acknowledge");
+}
+
+void CAMLMvc::Drain()
+{
+  std::unique_lock<std::mutex> lock(m_mutex);
+  if (!m_drainReq)
+  {
+    m_drainReq = true;
+    m_cv.notify_all();
+  }
+}
+
+bool CAMLMvc::IsDrained()
+{
+  std::unique_lock<std::mutex> lock(m_mutex);
+  return m_drained;
+}
+
+bool CAMLMvc::ResetPending()
+{
+  std::unique_lock<std::mutex> lock(m_mutex);
+  return m_resetReq != m_resetDone || m_stop;
+}
+
+void CAMLMvc::DoReset()
+{
+#ifdef HAS_EDGE264
+  edge264_flush(m_decoder);
+#endif
+  m_pts.clear();
+  m_lastPts = DVD_NOPTS_VALUE;
+  ioctl(m_fd, MVCOUT_IOC_FLUSH);
+  // the parameter sets may only have come with the extradata
+  if (!m_headers.empty())
+    DecodeUnits(m_headers.data(), m_headers.size());
+}
+
+void CAMLMvc::Process()
+{
+  if (!m_headers.empty())
+    DecodeUnits(m_headers.data(), m_headers.size());
+
+  for (;;)
+  {
+    Packet pkt;
+    bool drain = false;
+    {
+      std::unique_lock<std::mutex> lock(m_mutex);
+      m_cv.wait(lock, [&] {
+        return m_stop || m_resetReq != m_resetDone || !m_queue.empty() ||
+               (m_drainReq && !m_drained);
+      });
+      if (m_stop)
+        break;
+      if (m_resetReq != m_resetDone)
+      {
+        const uint64_t req = m_resetReq;
+        lock.unlock();
+        DoReset();
+        lock.lock();
+        m_resetDone = req;
+        m_cvIdle.notify_all();
+        continue;
+      }
+      if (!m_queue.empty())
+      {
+        pkt = std::move(m_queue.front());
+        m_queue.pop_front();
+        m_queueBytes -= pkt.data.size();
+      }
+      else
+        drain = true;
+    }
+
+    if (drain)
+    {
+      OutputFrames(true);
+      std::unique_lock<std::mutex> lock(m_mutex);
+      if (m_resetReq == m_resetDone && m_queue.empty())
+        m_drained = true;
+      continue;
+    }
+
+    if (pkt.pts != DVD_NOPTS_VALUE)
+    {
+      m_pts.insert(pkt.pts);
+      // pictures the decoder never outputs (broken links after a seek)
+      while (m_pts.size() > MAX_PENDING_PTS)
+        m_pts.erase(m_pts.begin());
+    }
+    DecodeUnits(pkt.data.data(), pkt.data.size());
+  }
+  std::unique_lock<std::mutex> lock(m_mutex);
+  m_cvIdle.notify_all();
+}
+
+void CAMLMvc::DecodeUnits(const uint8_t* data, size_t size)
+{
+#ifdef HAS_EDGE264
+  const uint8_t* end = data + size;
+  const uint8_t* nal = edge264_find_start_code(data, end, 0);
+
+  while (nal < end && !ResetPending())
+  {
+    nal += 3;
+    const uint8_t* next = edge264_find_start_code(nal, end, 0);
+    // a 4-byte start code leaves its leading zero on the previous unit
+    const uint8_t* stop = next;
+    while (stop > nal && stop[-1] == 0)
+      stop--;
+    int res;
+    while ((res = edge264_decode_NAL(m_decoder, nal, stop, nullptr, nullptr)) == ENOBUFS)
+    {
+      OutputFrames(false);
+      if (ResetPending())
+        return;
+    }
+    if (res == EBADMSG)
+      m_badNals++;
+    OutputFrames(false);
+    nal = next;
+  }
+#endif
+}
+
+void CAMLMvc::OutputFrames(bool drain)
+{
+#ifdef HAS_EDGE264
+  // an empty buffer (buf >= end) makes every held picture ready for output
+  static const uint8_t none = 0;
+  Edge264Frame frame;
+
+  for (int pass = 0; pass < 64; pass++)
+  {
+    const int res = drain ? edge264_decode_NAL(m_decoder, &none, &none, nullptr, nullptr) : 0;
+    while (!ResetPending() && edge264_get_frame(m_decoder, &frame, 0) == 0)
+    {
+      if (!OutputFrame(frame))
+        return;
+    }
+    // ENOBUFS: the pictures just taken made room for more
+    if (!drain || (res != 0 && res != ENOBUFS) || ResetPending())
+      break;
+  }
+#endif
+}
+
+bool CAMLMvc::OutputFrame(const Edge264Frame& frame)
+{
+#ifdef HAS_EDGE264
+  if (frame.width_Y != VIEW_W || frame.height_Y != VIEW_H)
+  {
+    CLog::Log(LOGWARNING, "CAMLMvc - unsupported picture {}x{}", frame.width_Y, frame.height_Y);
+    return true;
+  }
+
+  // pts in display order: the smallest one queued (like a decoder's reorder)
+  double pts;
+  if (!m_pts.empty())
+  {
+    pts = *m_pts.begin();
+    m_pts.erase(m_pts.begin());
+  }
+  else if (m_lastPts != DVD_NOPTS_VALUE)
+    pts = m_lastPts + m_frameDuration;
+  else
+    pts = 0.0;
+  m_lastPts = pts;
+
+  mvcout_frame f{};
+  f.timeout_ms = 100;
+  while (ioctl(m_fd, MVCOUT_IOC_DEQUEUE, &f) < 0)
+  {
+    if ((errno != EAGAIN && errno != EINTR) || ResetPending())
+      return false;
+  }
+
+  View left{frame.samples[0], frame.samples[1], frame.samples[2], frame.stride_Y,
+            frame.stride_C};
+  View right = left;
+  if (frame.samples_mvc[0])
+    right = View{frame.samples_mvc[0], frame.samples_mvc[1], frame.samples_mvc[2],
+                 frame.stride_Y, frame.stride_C};
+  if (m_swap)
+    std::swap(left, right);
+
+  uint8_t* dst = m_maps[f.index];
+  const Mode mode = m_mode;
+  uint32_t height = VIEW_H;
+  switch (mode)
+  {
+    case Mode::FramePacked:
+    {
+      // the second view in a helper thread, the first one here
+      std::thread t(ComposeFull, dst + (VIEW_H + FP_GAP) * m_stride, m_stride, right);
+      ComposeFull(dst, m_stride, left);
+      Black(dst + VIEW_H * m_stride, m_stride, FP_GAP);
+      t.join();
+      height = m_height;
+      break;
+    }
+    case Mode::SideBySide:
+    {
+      std::thread t(ComposeHalfWidth, dst, m_stride, VIEW_W / 2, right);
+      ComposeHalfWidth(dst, m_stride, 0, left);
+      t.join();
+      break;
+    }
+    case Mode::TopBottom:
+    {
+      std::thread t(ComposeHalfHeight, dst + (VIEW_H / 2) * m_stride, m_stride, right);
+      ComposeHalfHeight(dst, m_stride, left);
+      t.join();
+      break;
+    }
+    case Mode::Left:
+    case Mode::Right:
+      ComposeFull(dst, m_stride, mode == Mode::Left ? left : right);
+      break;
+  }
+
+  f.pts_us = pts > 0 ? static_cast<uint64_t>(pts) : 0;
+  f.duration = m_duration96;
+  f.width = VIEW_W;
+  f.height = height;
+  if (ioctl(m_fd, MVCOUT_IOC_QUEUE, &f) < 0)
+  {
+    CLog::Log(LOGERROR, "CAMLMvc - queue failed: {}", strerror(errno));
+    return false;
+  }
+  m_frames++;
+  return true;
+#else
+  return false;
+#endif
+}
