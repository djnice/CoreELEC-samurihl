             case RenderStereoMode::HARDWAREBASED:
@@ -3972,3 +4033,122 @@ std::string CAMLCodec::GetHDRStaticMetadata(bool dv_enable)
     CLog::Log(LOGDEBUG, "CAMLCodec::GetHDRStaticMetadata - Created the following config: {}", config_data);
   return config_data;
 }
+
+/*
+ * Software 3D MVC decoding: the stream goes to CAMLMvc (edge264 on the CPU),
+ * the composed pictures come back through the same amlvideo v4l queue as a
+ * hardware decoder's, so GetPicture/ReleaseFrame and the renderer are shared.
+ */
+bool CAMLCodec::OpenMvc(CDVDStreamInfo &hints)
+{
+  auto mvc = std::make_unique<CAMLMvc>();
+
+  // the provider needs its receiver chain before it registers
+  SetVfmMap("mvcoutpath", "mvcout amlvideo amvideo");
+  if (!mvc->Open(hints))
+  {
+    CSysfsPath("/sys/class/vfm/map", "rm mvcoutpath");
+    CLog::Log(LOGWARNING, "CAMLCodec::OpenMvc - software MVC decoding not possible, using the hardware decoder");
+    return false;
+  }
+  m_mvc = std::move(mvc);
+
+  am_private->video_format = VFORMAT_H264MVC;
+  am_private->video_codec_id = hints.codec;
+  am_private->video_codec_tag = hints.codec_tag;
+  am_private->video_width = hints.width;
+  am_private->video_height = hints.height;
+  am_private->video_rate = static_cast<int>(m_mvc->GetFrameDuration() * UNIT_FREQ / DVD_TIME_BASE + 0.5);
+
+  // frames are paced through amlvideo, as for the hardware decoders
+  CSysfsPath("/sys/class/tsync/enable", 0);
+  CSysfsPath("/sys/class/video/freerun_mode", 1);
+
+  m_mvcPollFd = open("/dev/amvideo", O_RDWR | O_NONBLOCK | O_CLOEXEC);
+  SetPollDevice(m_mvcPollFd);
+  m_display_rect = CRect(0, 0, CDisplaySettings::GetInstance().GetCurrentResolutionInfo().iWidth,
+                         CDisplaySettings::GetInstance().GetCurrentResolutionInfo().iHeight);
+  m_opened = true;
+  CLog::Log(LOGINFO, "CAMLCodec::OpenMvc - 3D MVC decoded in software");
+  return true;
+}
+
+void CAMLCodec::CloseMvc()
+{
+  SetPollDevice(-1);
+  m_mvc->Close();
+  m_mvc.reset();
+  m_opened = false;
+  CSysfsPath("/sys/class/vfm/map", "rm mvcoutpath");
+  if (m_mvcPollFd >= 0)
+    close(m_mvcPollFd);
+  m_mvcPollFd = -1;
+  CSysfsPath("/sys/class/tsync/enable", 1);
+  ShowMainVideo(false);
+
+  PosixFilePtr closing;
+  {
+    std::lock_guard<std::mutex> lock(m_amlVideoFileMutex);
+    closing.swap(m_amlVideoFile);
+  }
+}
+
+CDVDVideoCodec::VCReturn CAMLCodec::GetPictureMvc(VideoPicture *pVideoPicture)
+{
+  if (!m_opened)
+    return CDVDVideoCodec::VC_ERROR;
+
+  if (m_drain)
+    m_mvc->Drain();
+
+  if (DequeueBuffer() == 0)
+  {
+    m_tp_last_frame = std::chrono::steady_clock::now();
+    pVideoPicture->iFlags = 0;
+    const int64_t delta = static_cast<int64_t>(m_cur_pts - m_last_pts);
+    pVideoPicture->iDuration = (m_last_pts != DVD_NOPTS_VALUE && delta > 0)
+                                   ? static_cast<double>(delta)
+                                   : m_mvc->GetFrameDuration();
+    pVideoPicture->dts = DVD_NOPTS_VALUE;
+    pVideoPicture->pts = static_cast<double>(m_cur_pts);
+    pVideoPicture->stereoMode = m_hints.stereo_mode;
+    if (pVideoPicture->stereoMode == "block_lr" && m_processInfo.GetVideoSettings().m_StereoInvert)
+      pVideoPicture->stereoMode = "block_rl";
+    else if (pVideoPicture->stereoMode == "block_rl" && m_processInfo.GetVideoSettings().m_StereoInvert)
+      pVideoPicture->stereoMode = "block_lr";
+    CLog::Log(LOGDEBUG, LOGVIDEO, "CAMLCodec::GetPictureMvc: index: {:d}, pts: {:.3f}",
+              m_bufferIndex, pVideoPicture->pts / DVD_TIME_BASE);
+    return CDVDVideoCodec::VC_PICTURE;
+  }
+
+  if (m_drain)
+  {
+    if (m_mvc->IsDrained())
+    {
+      int queued = 0;
+      PosixFilePtr amlVideoFile;
+      {
+        std::lock_guard<std::mutex> lock(m_amlVideoFileMutex);
+        amlVideoFile = m_amlVideoFile;
+      }
+      if (!amlVideoFile || amlVideoFile->IOControl(AMLVIDEO_IOC_GET_VFQ, &queued) != 0 ||
+          queued == 0)
+        return CDVDVideoCodec::VC_EOF;
+    }
+    // The decoder thread still decodes its input queue and squeezes out the
+    // pictures it holds, and they pass the amlvideo queue one by one at the
+    // display rate: VC_BUFFER would end the player's drain loop here and lose
+    // them all (the last second of every file), VC_NONE keeps it polling.
+    if (std::chrono::steady_clock::now() - m_tp_last_frame <
+        std::chrono::seconds(m_decoder_timeout))
+    {
+      std::this_thread::sleep_for(std::chrono::milliseconds(5));
+      return CDVDVideoCodec::VC_NONE;
+    }
+    CLog::Log(LOGWARNING, "CAMLCodec::GetPictureMvc - drain timed out");
+    return CDVDVideoCodec::VC_EOF;
+  }
+
+  // a full input queue: nothing to take, the decoder is busy
+  return m_mvc->IsFull() ? CDVDVideoCodec::VC_NONE : CDVDVideoCodec::VC_BUFFER;
+}
