--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/AMLMvc.cpp
@@ -0,0 +1,593 @@
+/*
+ *  Copyright (C) 2026 Team CoreELEC (https://coreelec.org)
+ *  This file is part of Kodi - https://kodi.tv
+ *
