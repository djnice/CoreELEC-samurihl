+/* demo mode: L1 of the composed picture and of the base layer (see felgpu_get_stats) */
+static void measure(struct felgpu *f, GLuint bl_tex)
+{
+    int gx0, gx1, gy0, gy1;
+    sample_range(f->w, f->sw, f->use_l5 ? f->l5[0] : 0, f->use_l5 ? f->l5[1] : 0, &gx0, &gx1);
