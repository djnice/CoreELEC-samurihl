+// SMPTE ST 2084, 12-bit PQ code -> cd/m^2
+float PqNits(int code)
+{
+  const double m1 = 0.1593017578125, m2 = 78.84375;
+  const double c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;
+  const double e = std::pow(std::max(code, 0) / 4095.0, 1.0 / m2);
+  return static_cast<float>(10000.0 * std::pow(std::max(e - c1, 0.0) / (c2 - c3 * e), 1.0 / m1));
+}
+
+std::string Nits(float v, bool sign = false)
+{
+  const std::string s = std::fabs(v) < 10.0f ? StringUtils::Format("{:.1f}", std::fabs(v))
+                                            : StringUtils::Format("{}", std::lround(std::fabs(v)));
+  return (sign ? (v < 0.0f ? "-" : "+") : (v < 0.0f ? "-" : "")) + s;
+}
+
+// demo mode: the measured L1 of both pictures and the RPU's own at the top of
+// each half, see felgpu_get_stats
+void SetDemoOverlay(felgpu* fel, const float n[4], const felgpu_meta& m)
+{
+  felgpu_set_overlay(fel, 0, ("FEL  MAX " + Nits(n[0]) + "  AVG " + Nits(n[1]) + " NIT").c_str());
+  felgpu_set_overlay(fel, 1, m.l1_max_pq < 0 ? "RPU L1  -"
+                                             : ("RPU L1  MAX " + Nits(PqNits(m.l1_max_pq)) + "  AVG " +
+                                                Nits(PqNits(m.l1_avg_pq)) + " NIT")
+                                                   .c_str());
+  felgpu_set_overlay(fel, 2, ("BL   MAX " + Nits(n[2]) + "  AVG " + Nits(n[3]) + " NIT").c_str());
+  felgpu_set_overlay(fel, 3, ("FEL-BL  MAX " + Nits(n[0] - n[2], true) + "  AVG " +
+                              Nits(n[1] - n[3], true) + " NIT")
+                                 .c_str());
+}
