+  //! Runs the network and file probing part of RetrieveInfoForMovie() for the new plain movie
+  //! files of one directory listing on a few threads. Each thread has its own database
+  //! connection and its own scraper instance (a CScraper is not synchronised), so nothing is
+  //! shared but the job list.
+  class CVideoInfoScanner::CMoviePrefetcher
+  {
+  public:
+    struct Job
+    {
+      std::shared_ptr<CFileItem> item; //!< private copy, receives the details
+      std::string scraperPath; //!< path whose scraper and settings apply
+      std::string title; //!< what the serial path searches for
+      int year{-1};
+      bool done{false};
+      bool found{false};
+    };
+
+    CMoviePrefetcher(std::vector<Job> jobs,
+                     bool bDirNames,
+                     bool useLocal,
+                     const std::atomic<bool>& stop,
+                     size_t threads)
+      : m_jobs(std::move(jobs)),
+        m_dirNames(bDirNames),
+        m_useLocal(useLocal),
+        m_extractFlags(CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
+            CSettings::SETTING_MYVIDEOS_EXTRACTFLAGS)),
+        m_stop(stop)
+    {
+      for (size_t i = 0; i < m_jobs.size(); ++i)
+        m_index.try_emplace(m_jobs[i].item->GetPath(), i);
+      for (size_t i = 0; i < threads; ++i)
+        m_threads.emplace_back([this] { Worker(); });
+    }
+
+    ~CMoviePrefetcher()
+    {
+      m_abort = true;
+      for (auto& thread : m_threads)
+        thread.join();
+    }
+
+    CMoviePrefetcher(const CMoviePrefetcher&) = delete;
+    CMoviePrefetcher& operator=(const CMoviePrefetcher&) = delete;
+
+    //! \brief The job of \p path once it is done, nullptr if there is none or the scan stops
+    const Job* Wait(const std::string& path, const std::atomic<bool>& stop)
+    {
+      const auto it{m_index.find(path)};
+      if (it == m_index.end())
+        return nullptr;
+
+      std::unique_lock lock(m_mutex);
+      const Job& job{m_jobs[it->second]};
+      while (!job.done)
+      {
+        if (stop)
+          return nullptr;
+        m_done.wait_for(lock, std::chrono::milliseconds(100));
+      }
+      return &job;
+    }
+
+  private:
+    void Worker()
+    {
+      // The movie scraper is a reusable plugin script: concurrent runs must not share one
+      CScriptInvocationManager::SetExclusiveInvokers(true);
+
+      CVideoDatabase db;
+      const bool dbOpen{db.Open()};
+      while (true)
+      {
+        const size_t i{m_next++};
+        if (i >= m_jobs.size())
+          break;
+
+        Job& job{m_jobs[i]};
+        const bool found{dbOpen && !m_abort && !m_stop && Fetch(db, job)};
+        {
+          std::unique_lock lock(m_mutex);
+          job.found = found;
+          job.done = true;
+        }
+        m_done.notify_all();
+      }
+      if (dbOpen)
+        db.Close();
+    }
+
+    bool Fetch(CVideoDatabase& db, Job& job) const
+    {
+      // A fresh instance for this thread, with the path's settings
+      const ScraperPtr scraper{db.GetScraperForPath(job.scraperPath)};
+      if (!scraper || scraper->Content() != ContentType::MOVIES)
+        return false;
+
+      CFileItem& item{*job.item};
+
+      // What the serial path reads first: anything but embedded title tags (an nfo, a url)
+      // goes the serial way
+      if (m_useLocal)
+      {
+        const std::unique_ptr<IVideoInfoTagLoader> loader{
+            CVideoInfoTagLoaderFactory::CreateLoader(item, scraper, m_dirNames)};
+        if (loader)
+        {
+          CVideoInfoTag tag;
+          const InfoType result{loader->Load(tag, false)};
+          if (result == InfoType::TITLE)
+          {
+            job.title = tag.GetTitle();
+            job.year = tag.GetYear();
+          }
+          else if (result != InfoType::NONE)
+            return false;
+        }
+      }
+
+      CVideoInfoDownloader downloader(scraper);
+      MOVIELIST movies;
+      if (downloader.FindMovie(job.title, job.year, movies) <= 0 || movies.empty() || m_abort ||
+          m_stop)
+        return false;
+
+      CVideoInfoTag details;
+      if (!downloader.GetDetails({}, movies[0], details) || m_abort || m_stop)
+        return false;
+
+      *item.GetVideoInfoTag() = details;
+
+      // The serial path extracts these only when missing, so the slow file part is done here
+      // as well
+      if (m_extractFlags)
+        CDVDFileInfo::GetFileStreamDetails(&item);
+
+      CLog::Log(LOGDEBUG, "VideoInfoScanner: fetched ahead '{}' for {}", details.m_strTitle,
+                CURL::GetRedacted(item.GetPath()));
+      return true;
+    }
+
+    std::vector<Job> m_jobs;
+    std::unordered_map<std::string, size_t> m_index;
+    const bool m_dirNames;
+    const bool m_useLocal;
+    const bool m_extractFlags;
+    const std::atomic<bool>& m_stop;
+    std::atomic<bool> m_abort{false};
+    std::atomic<size_t> m_next{0};
+    std::mutex m_mutex;
+    std::condition_variable m_done;
+    std::vector<std::thread> m_threads;
+  };
+
