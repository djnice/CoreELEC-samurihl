+  void CVideoInfoScanner::StartMoviePrefetch(const CFileItemList& items,
+                                             bool bDirNames,
+                                             bool useLocal)
+  {
+    //! Several movies at once, but few enough for the scraper sites and for decoding a frame of
+    //! each file for its HDR details
+    constexpr size_t PREFETCH_THREADS{4};
+
+    StopMoviePrefetch();
+
+    const ScraperPtr scraper{m_database.GetScraperForPath(items.GetPath(), &m_scraperCache)};
+    if (!scraper || scraper->Content() != ContentType::MOVIES)
+      return;
+
+    std::vector<CMoviePrefetcher::Job> jobs;
+    for (const auto& item : items)
+    {
+      const std::string& path{item->GetPath()};
+      if (item->IsFolder() || !IsVideo(*item) || item->IsNFO() || PLAYLIST::IsPlayList(*item) ||
+          URIUtils::IsStack(path) || IsDisc(path) ||
+          CUtil::ExcludeFileOrFolder(path, m_advancedSettings->m_moviesExcludeFromScanRegExps,
+                                     &m_regexpCache) ||
+          m_database.HasMovieInfo(item->GetDynPath()))
+        continue;
+
+      // An identifier in the filename is looked up directly by the serial path
+      const CFilenameAttributes attributes(URIUtils::GetFileName(path), &m_regexpCache);
+      std::string identifierType;
+      std::string identifier;
+      if (scraper->IsPython() && attributes.GetIdentifier(identifierType, identifier))
+        continue;
+
+      CMoviePrefetcher::Job job;
+      job.item = std::make_shared<CFileItem>(*item);
+      job.scraperPath = items.GetPath();
+      job.title = item->GetMovieName(bDirNames);
+      jobs.emplace_back(std::move(job));
+    }
+
+    if (jobs.size() < 2)
+      return;
+
+    const size_t threads{std::min(PREFETCH_THREADS, jobs.size())};
+    CLog::Log(LOGINFO, "VideoInfoScanner: fetching {} new movies of {} ahead on {} threads",
+              jobs.size(), CURL::GetRedacted(items.GetPath()), threads);
+    m_moviePrefetcher =
+        std::make_unique<CMoviePrefetcher>(std::move(jobs), bDirNames, useLocal, m_bStop, threads);
+  }
+
+  void CVideoInfoScanner::StopMoviePrefetch()
+  {
+    m_moviePrefetcher.reset();
+  }
