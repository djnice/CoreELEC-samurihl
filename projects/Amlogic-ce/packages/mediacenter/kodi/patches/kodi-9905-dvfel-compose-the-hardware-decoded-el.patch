 namespace
 {
+// Remove the Dolby Vision EL NAL units (HEVC type 63) from an annex-b access
+// unit in place; returns the new size. Units are delimited by their start
+// codes (00 00 01 cannot occur inside a NAL unit: emulation prevention); a
+// zero byte before a start code (4-byte form) stays with the unit it starts.
+int StripDoviElNals(uint8_t* data, int size)
+{
+  std::vector<int> begin, header;
+  for (int i = 0; i + 3 < size; i++)
+  {
+    if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1)
+    {
+      begin.push_back(i > 0 && data[i - 1] == 0 ? i - 1 : i);
+      header.push_back(i + 3);
+      i += 2;
+    }
+  }
+  if (begin.empty())
+    return size;
+  int out = begin[0];
+  for (size_t k = 0; k < begin.size(); k++)
+  {
+    const int end = k + 1 < begin.size() ? begin[k + 1] : size;
+    if (((data[header[k]] >> 1) & 0x3f) == 63)
+      continue;
+    if (out != begin[k])
+      memmove(data + out, data + begin[k], end - begin[k]);
+    out += end - begin[k];
+  }
+  return out;
+}
