+std::shared_ptr<felgpu_meta> CAMLDvFel::TakeMeta(int64_t pts, int auDelta)
+{
+  std::lock_guard<std::mutex> lock(m_lock);
+  auto it = FindPts(m_metaByPts, pts);
+  if (it == m_metaByPts.end())
+    return nullptr;
+  std::shared_ptr<felgpu_meta> meta = it->second.meta;
+  if (auDelta != 0)
+  {
+    // an EL of another picture order: the kernel paired the frame with the EL
+    // picture shown at its time, coded auDelta access units away; its RPU is
+    // the one of that access unit (as for the software decoded EL)
+    meta = nullptr;
+    auto p = m_ptsBySeq.find(it->second.seq + auDelta);
+    if (p != m_ptsBySeq.end())
+    {
+      auto e = m_metaByPts.find(p->second);
+      if (e != m_metaByPts.end())
+        meta = e->second.meta;
+    }
+    if (!m_reorderLogged)
+    {
+      m_reorderLogged = true;
+      CLog::Log(LOGINFO,
+                "CAMLDvFel: the EL picture order differs from the base layer, pairing by "
+                "display order");
+    }
+  }
+  // frames are shown in display order: older RPUs are not needed any more,
+  // except by an EL of another picture order
+  m_metaByPts.erase(m_metaByPts.begin(), m_metaByPts.lower_bound(pts - META_KEEP_US));
+  return meta;
+}
