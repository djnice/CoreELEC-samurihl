+void CScreenshotAML::BlendVideoUnderGui(
+    uint8_t* pixels, unsigned int width, unsigned int height, int stride, AVPixelFormat format)
+{
+  if (!pixels || width == 0 || height == 0)
+    return;
+
+  CRect dest = GetVideoRect();
+  dest.Intersect(CRect(0.0f, 0.0f, static_cast<float>(width), static_cast<float>(height)));
+  const unsigned int x0 = static_cast<unsigned int>(std::lround(dest.x1));
+  const unsigned int y0 = static_cast<unsigned int>(std::lround(dest.y1));
+  const unsigned int x1 = std::min(width, static_cast<unsigned int>(std::lround(dest.x2)));
+  const unsigned int y1 = std::min(height, static_cast<unsigned int>(std::lround(dest.y2)));
+  if (x1 <= x0 || y1 <= y0)
+    return;
+
+  const unsigned int videoWidth = x1 - x0;
+  const unsigned int videoHeight = y1 - y0;
+  const auto video = CaptureVideoFrame(videoWidth, videoHeight);
+  if (!video)
+    return;
+
+  const size_t rowBytes = static_cast<size_t>(std::abs(stride));
+  const unsigned int bpp = BytesPerPixel(format);
+  for (unsigned int y = 0; y < videoHeight; ++y)
+  {
+    // the readback is bottom-up when the stride is negative
+    const unsigned int row = y0 + y;
+    uint8_t* line = pixels + (stride < 0 ? height - 1 - row : row) * rowBytes;
+    const uint8_t* v = video.get() + static_cast<size_t>(y) * videoWidth * 4;
+    for (unsigned int x = 0; x < videoWidth; ++x, v += 4)
+    {
+      if (!BlendPixel(line + static_cast<size_t>(x0 + x) * bpp, v, format))
       {
-        usleep(10000);
-        retry--;
+        CLog::LogF(LOGWARNING, "readback format {} not handled; video left out",
+                   static_cast<int>(format));
+        return;
       }
     }
-    close(captureFd);
-    delete [] videoBuffer;
   }
 }
