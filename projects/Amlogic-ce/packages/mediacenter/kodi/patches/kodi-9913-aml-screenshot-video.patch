+// one capture of the shown picture as B, G, R rows of width * 3 bytes
+bool ReadVideoFrame(std::vector<uint8_t>& bgr, unsigned int width, unsigned int height)
+{
+  const int fd = open(CAPTURE_DEVICEPATH, O_RDWR);
+  if (fd < 0)
+    return false;
+
+  const ssize_t size = static_cast<ssize_t>(width) * height * 3;
+  bgr.resize(static_cast<size_t>(size));
+  ssize_t got = -1;
+  for (int attempt = 0; attempt < 3 && got != size; ++attempt)
+  {
+    // the picture on screen now: no wait for the next frame, works when paused
+    ioctl(fd, AMVIDEOCAP_IOW_SET_WANTFRAME_WIDTH, width);
+    ioctl(fd, AMVIDEOCAP_IOW_SET_WANTFRAME_HEIGHT, height);
+    ioctl(fd, AMVIDEOCAP_IOW_SET_WANTFRAME_AT_FLAGS, CAP_FLAG_AT_CURRENT);
+    got = pread(fd, bgr.data(), bgr.size(), 0);
+    if (got < 0 && errno == ENODATA)
+      break; // the video layer is off
+  }
+  close(fd);
 
