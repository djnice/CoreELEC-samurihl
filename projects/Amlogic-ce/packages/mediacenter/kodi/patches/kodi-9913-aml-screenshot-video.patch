+bool CRendererAML::CaptureVideoFrame(const KODI::RENDERING::CAPTURE::CaptureSpec& spec,
+                                     KODI::RENDERING::CAPTURE::CaptureResult& result)
+{
+  using namespace KODI::RENDERING::CAPTURE;
+
+  // native size: the picture as shown on screen
+  const unsigned int width =
+      spec.width ? spec.width : static_cast<unsigned int>(std::lround(m_destRect.Width()));
+  const unsigned int height =
+      spec.height ? spec.height : static_cast<unsigned int>(std::lround(m_destRect.Height()));
+  auto pixels = CScreenshotAML::CaptureVideoFrame(width, height);
+  if (!pixels)
+    return false;
+
+  result.pixels = std::make_shared<CHeapCapturePixels>(std::move(pixels));
+  result.width = width;
+  result.height = height;
+  result.stride = static_cast<int>(width * 4);
+  result.format = AV_PIX_FMT_BGRA;
+  result.content = CaptureContent::VIDEO;
+  // the driver converts to full-range RGB and maps an HDR source to SDR
+  result.color.primaries = AVCOL_PRI_BT709;
+  result.color.transfer = AVCOL_TRC_BT709;
+  result.color.range = AVCOL_RANGE_JPEG;
+  return true;
+}
