+
+// VSVDB v2 black level: 0 keeps the display's own figure, N selects the 5-bit
+// min-luminance index N-1 (PQ12 = 20 x index), see aml_dv_apply_vsvdb. The whole
+// range is offered - up to about 1 cd/m^2 - since projectors and panels that
+// cannot reach a true black need far more than an OLED.
+void VSVDBMinLumFiller(const SettingConstPtr& setting,
+                       std::vector<IntegerSettingOption>& list,
+                       int& current)
+{
+  // PQ12 = 20 x index in cd/m^2, held as 1e-8 cd/m^2
+  static const long nits_1e8[32] = {
+      0,        64354,    223738,   478965,   837904,   1310152,  1906315,  2637791,
+      3516709,  4555910,  5768953,  7170139,  8774531,  10597988, 12657199, 14969718,
+      17554001, 20429448, 23616447, 27136414, 31011844, 35266356, 39924746, 45013035,
+      50558532, 56589883, 63137136, 70231800, 77906912, 86197104, 95138673, 104769654};
+
+  list.clear();
+  list.emplace_back(vs10_label(60344), 0); // Display
+  for (int i = 0; i < 32; i++)
+    list.emplace_back(StringUtils::Format("PQ {} ({:.8f} cd/m²)", i * 20,
+                                          static_cast<double>(nits_1e8[i]) / 1e8),
+                      i + 1);
+}
