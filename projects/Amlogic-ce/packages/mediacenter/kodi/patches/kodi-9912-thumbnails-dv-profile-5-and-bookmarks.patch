 namespace
 {
+/*! After SeekAndDecodeFirstPicture (the keyframe before the time): decode on until the picture
+ * at seekTo_ms, so a bookmark thumbnail shows the bookmarked moment. Bounded by packets and time;
+ * keeps the last good picture. */
+void DecodeOnToTime(CDVDDemux& demuxer,
+                    CDVDVideoCodec& codec,
+                    int videoStream,
+                    int64_t seekTo_ms,
+                    VideoPicture& picture,
+                    int& packetsTried)
+{
+  const double target = static_cast<double>(seekTo_ms) * DVD_TIME_BASE / 1000.0;
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(4);
+  for (int packets = 0; packets < 600; packets++)
+  {
+    if (picture.pts == DVD_NOPTS_VALUE || picture.pts >= target - DVD_TIME_BASE / 50.0 ||
+        std::chrono::steady_clock::now() > deadline)
+      return;
+    DemuxPacket* pPacket = demuxer.Read();
+    packetsTried++;
+    if (!pPacket)
+      return;
+    if (pPacket->iStreamId != videoStream || pPacket->isELPackage)
+    {
+      CDVDDemuxUtils::FreeDemuxPacket(pPacket);
+      continue;
+    }
+    codec.AddData(*pPacket);
+    CDVDDemuxUtils::FreeDemuxPacket(pPacket);
+
+    VideoPicture next = {};
+    CDVDVideoCodec::VCReturn state = CDVDVideoCodec::VC_NONE;
+    while (state == CDVDVideoCodec::VC_NONE)
+      state = codec.GetPicture(&next);
+    if (state == CDVDVideoCodec::VC_PICTURE && !(next.iFlags & DVP_FLAG_DROPPED))
+      picture.CopyRef(next);
+  }
+}
+
+/* Dolby Vision profile 5: the base layer is IPT-PQ-c2, not BT.2020 YCbCr, so without the RPU it
+ * decodes to a green/purple picture. Rebuild it like libplacebo does (pl_shader_dovi_reshape +
+ * pl_shader_decode_color): per component reshaping (polynomial or MMR) of the normalized BL, the
+ * RPU's ycc_to_rgb matrix (-> L'M'S', PQ), PQ EOTF, the RPU's rgb_to_lms matrix and the ICtCp
+ * LMS -> BT.2020 RGB matrix, PQ OETF. The result is a PQ BT.2020 RGB48 frame at the thumbnail size
+ * (box-averaged samples), tagged with the frame's L1 max as mastering peak, which then takes the
+ * same sws_scale_frame tonemap as any HDR10 picture. */
+double PqEotf(double e) // PQ signal -> linear, 1.0 = 10000 nits
+{
+  constexpr double m1 = 2610.0 / 16384, m2 = 2523.0 / 4096 * 128, c1 = 3424.0 / 4096,
+                   c2 = 2413.0 / 4096 * 32, c3 = 2392.0 / 4096 * 32;
+  if (e <= 0)
+    return 0;
+  const double p = std::pow(e, 1 / m2);
+  return std::pow(std::max(p - c1, 0.0) / (c2 - c3 * p), 1 / m1);
+}
+
+double PqOetf(double y)
+{
+  constexpr double m1 = 2610.0 / 16384, m2 = 2523.0 / 4096 * 128, c1 = 3424.0 / 4096,
+                   c2 = 2413.0 / 4096 * 32, c3 = 2392.0 / 4096 * 32;
+  if (y <= 0)
+    return 0;
+  const double p = std::pow(y, m1);
+  return std::pow((c1 + c2 * p) / (1 + c3 * p), m2);
+}
+
+double DoviReshape(const AVDOVIReshapingCurve& c,
+                   int comp,
+                   const double s3[3],
+                   double coefScale,
+                   double pivotScale)
+{
+  const double lo = c.pivots[0] * pivotScale;
+  const double hi = c.pivots[c.num_pivots - 1] * pivotScale;
+  const double s = std::clamp(s3[comp], lo, hi);
+  int i = 0;
+  while (i < c.num_pivots - 2 && s >= c.pivots[i + 1] * pivotScale)
+    i++;
+  double r = 0;
+  if (c.mapping_idc[i] == AV_DOVI_MAPPING_POLYNOMIAL)
+  {
+    for (int k = c.poly_order[i]; k >= 0; k--)
+      r = r * s + c.poly_coef[i][k] * coefScale;
+  }
+  else
+  {
+    // MMR: constant + per order the 3 components and their 4 cross products, to the order's power
+    const double x[7] = {s3[0],         s3[1],         s3[2], s3[0] * s3[1], s3[0] * s3[2],
+                         s3[1] * s3[2], s3[0] * s3[1] * s3[2]};
+    r = c.mmr_constant[i] * coefScale;
+    for (int o = 0; o < c.mmr_order[i]; o++)
+      for (int k = 0; k < 7; k++)
+        r += c.mmr_coef[i][o][k] * coefScale * std::pow(x[k], o + 1);
+  }
+  return std::clamp(r, 0.0, 1.0);
+}
+
+AVFrame* DoviProfile5ToPQ(const VideoPicture& picture,
+                          uint8_t* const planes[],
+                          const int strides[],
+                          unsigned int width,
+                          unsigned int height)
+{
+  const AVPixelFormat format = picture.videoBuffer->GetFormat();
+  const int depth =
+      format == AV_PIX_FMT_YUV420P10 ? 10 : (format == AV_PIX_FMT_YUV420P ? 8 : 0);
+  if (!depth || !picture.doviMetadata || !width || !height)
+    return nullptr;
+  const auto* md = reinterpret_cast<const AVDOVIMetadata*>(picture.doviMetadata->data());
+  const AVDOVIRpuDataHeader* hdr = av_dovi_get_header(md);
+  const AVDOVIDataMapping* map = av_dovi_get_mapping(md);
+  const AVDOVIColorMetadata* col = av_dovi_get_color(md);
+
+  const double vmax = (1 << depth) - 1;
+  const double coefScale = 1.0 / static_cast<double>(1LL << hdr->coef_log2_denom);
+  const double pivotScale = 1.0 / ((1 << hdr->bl_bit_depth) - 1);
+  // ICtCp's LMS -> BT.2020 RGB (libplacebo pl_ipt_lms2rgb), applied after the RPU's linear matrix
+  static constexpr double lms2rgb[9] = {3.43661,  -2.50645, 0.06984,  -0.79133, 1.98360,
+                                        -0.19227, -0.02595, -0.09891, 1.12486};
+  double lin[9], m[9], nl[9], off[3];
+  for (int i = 0; i < 9; i++)
+  {
+    lin[i] = av_q2d(col->rgb_to_lms_matrix[i]);
+    nl[i] = av_q2d(col->ycc_to_rgb_matrix[i]);
+  }
+  for (int i = 0; i < 3; i++)
+    off[i] = av_q2d(col->ycc_to_rgb_offset[i]);
+  for (int r = 0; r < 3; r++)
+    for (int c = 0; c < 3; c++)
+      m[r * 3 + c] = lms2rgb[r * 3 + 0] * lin[0 * 3 + c] + lms2rgb[r * 3 + 1] * lin[1 * 3 + c] +
+                     lms2rgb[r * 3 + 2] * lin[2 * 3 + c];
+
+  AVFrame* dst = av_frame_alloc();
+  if (!dst)
+    return nullptr;
+  dst->width = static_cast<int>(width);
+  dst->height = static_cast<int>(height);
+  dst->format = AV_PIX_FMT_RGB48;
+  if (av_frame_get_buffer(dst, 0) < 0)
+  {
+    av_frame_free(&dst);
+    return nullptr;
+  }
+  dst->colorspace = AVCOL_SPC_RGB;
+  dst->color_range = AVCOL_RANGE_JPEG;
+  dst->color_primaries = AVCOL_PRI_BT2020;
+  dst->color_trc = AVCOL_TRC_SMPTE2084;
+
+  const int srcW = static_cast<int>(picture.iWidth), srcH = static_cast<int>(picture.iHeight);
+  const int bw = std::max(srcW / static_cast<int>(width), 1);
+  const int bh = std::max(srcH / static_cast<int>(height), 1);
+  auto sample = [&](int p, int x, int y) -> double
+  {
+    const uint8_t* row = planes[p] + static_cast<size_t>(y) * strides[p];
+    return depth > 8 ? reinterpret_cast<const uint16_t*>(row)[x] : row[x];
+  };
+  for (unsigned int y = 0; y < height; y++)
+  {
+    auto* out = reinterpret_cast<uint16_t*>(dst->data[0] + static_cast<size_t>(y) * dst->linesize[0]);
+    const int sy = std::clamp(static_cast<int>((y + 0.5) * srcH / height) - bh / 2, 0, srcH - bh);
+    for (unsigned int x = 0; x < width; x++)
+    {
+      const int sx = std::clamp(static_cast<int>((x + 0.5) * srcW / width) - bw / 2, 0, srcW - bw);
+      double acc[3] = {0, 0, 0};
+      int n = 0, nc = 0;
+      for (int j = 0; j < bh; j++)
+        for (int i = 0; i < bw; i++, n++)
+          acc[0] += sample(0, sx + i, sy + j);
+      for (int j = 0; j < (bh + 1) / 2; j++)
+        for (int i = 0; i < (bw + 1) / 2; i++, nc++)
+          for (int p = 1; p < 3; p++)
+            acc[p] += sample(p, sx / 2 + i, sy / 2 + j);
+      const double s[3] = {acc[0] / n / vmax, acc[1] / nc / vmax, acc[2] / nc / vmax};
+      double v[3], lms[3];
+      for (int c = 0; c < 3; c++)
+        v[c] = DoviReshape(map->curves[c], c, s, coefScale, pivotScale);
+      for (int c = 0; c < 3; c++)
+        lms[c] = PqEotf(nl[c * 3 + 0] * (v[0] - off[0]) + nl[c * 3 + 1] * (v[1] - off[1]) +
+                        nl[c * 3 + 2] * (v[2] - off[2]));
+      for (int c = 0; c < 3; c++)
+      {
+        const double rgb = m[c * 3 + 0] * lms[0] + m[c * 3 + 1] * lms[1] + m[c * 3 + 2] * lms[2];
+        out[x * 3 + c] = static_cast<uint16_t>(PqOetf(std::clamp(rgb, 0.0, 1.0)) * 65535 + 0.5);
+      }
+    }
+  }
+
+  // tonemapping peak: the frame's L1 max (as a DV display would), else the source max
+  double peakPq = col->source_max_pq / 4095.0;
+  const AVDOVIDmData* l1 = av_dovi_find_level(md, 1);
+  if (l1 && l1->l1.max_pq)
+    peakPq = l1->l1.max_pq / 4095.0;
+  if (AVMasteringDisplayMetadata* mdm = av_mastering_display_metadata_create_side_data(dst))
+  {
+    static constexpr double prim[3][2] = {{0.708, 0.292}, {0.170, 0.797}, {0.131, 0.046}};
+    for (int i = 0; i < 3; i++)
+    {
+      mdm->display_primaries[i][0] = av_d2q(prim[i][0], 50000);
+      mdm->display_primaries[i][1] = av_d2q(prim[i][1], 50000);
+    }
+    mdm->white_point[0] = av_d2q(0.3127, 50000);
+    mdm->white_point[1] = av_d2q(0.3290, 50000);
+    mdm->max_luminance = av_d2q(PqEotf(peakPq) * 10000, 10000);
+    mdm->min_luminance = av_d2q(0.005, 10000);
+    mdm->has_primaries = mdm->has_luminance = 1;
+  }
+  return dst;
+}
