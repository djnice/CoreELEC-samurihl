+struct AVFrame;
+struct felgpu_meta;
+
+/*
+ * Dolby Vision profile 7 FEL composition on Amlogic S5 (S928X), whose Dolby
+ * Vision hardware has no enhancement layer input.
+ *
+ * The hardware decoder still decodes the base layer and the bitstream
+ * converter rewrites the RPU to profile 8.1 with a no-op mapping. The dvfel
+ * kernel node (/dev/dvfel), inserted between the decoder and the display,
+ * hands every decoded base layer frame to this class, which composes it on
+ * the GPU with the enhancement layer (decoded here in software) and the
+ * original RPU mapping, so the display shows the full FEL reconstruction.
+ *
+ * Data flow per packet: the converter reports the original RPU and the EL
+ * NAL units through IDoviElSink while converting; CommitPacket() queues them
+ * for the EL decoder, and a decoded EL picture is filed with its RPU under
+ * the pts of the packet that carried it; the kernel reports the base layer
+ * pts with each frame. The EL may also be coded in another picture order
+ * than the base layer (e.g. B frames over an I/P base layer); once that
+ * shows, EL pictures are paired by display order like the hardware
+ * composers do: each takes the earliest packet pts not handed out yet.
+ */
+class CAMLDvFel : public IDoviElSink
+{
+public:
+  CAMLDvFel() = default;
+  ~CAMLDvFel() override;
+
+  // the dvfel kernel node is loaded
+  static bool IsAvailable();
+
+  // Starts EL decoding and the GPU compositor and routes the decoder output
+  // through dvfel. Must be called before the hardware decoder is opened.
+  bool Start(int width, int height);
+  void Stop();
+  bool IsStarted() const { return m_started; }
+
+  // seek / flush
+  void Reset();
+
+  // the data collected by the sink belongs to the packet with this pts
+  void CommitPacket(double pts);
+  // forget what the sink collected (packet not queued to the decoder)
+  void DropPacket();
+
+  // IDoviElSink
+  void OnDoviRpu(const uint8_t* nal, uint32_t size) override;
+  void OnDoviElNal(const uint8_t* nal, uint32_t size) override;
+
+private:
+  struct ElPacket
+  {
+    int64_t pts;
+    std::vector<uint8_t> data; // Annex-B
+    std::shared_ptr<felgpu_meta> meta; // the RPU travels with the EL picture
+    bool flush;
+  };
+  struct ElFrame
+  {
+    AVFrame* frame;
+    std::shared_ptr<felgpu_meta> meta;
+  };
+
+  void ElThread();
+  void GpuThread(std::promise<bool> ready);
+  bool WaitForFrame(int64_t pts, AVFrame*& frame, std::shared_ptr<felgpu_meta>& meta);
+  void RouteThroughDvfel(bool enable);
+
+  int m_width{0};
+  int m_height{0};
+  bool m_started{false};
+  std::atomic<bool> m_stop{false};
+
+  // per packet, filled by the sink (decode thread)
+  std::vector<uint8_t> m_pendingRpu;
+  std::vector<uint8_t> m_pendingEl;
+  std::shared_ptr<felgpu_meta> m_lastMeta;
+
+  std::mutex m_lock;
+  std::condition_variable m_elCond;    // EL input queue
+  std::condition_variable m_readyCond; // new EL frame
+  std::deque<ElPacket> m_elQueue;
+  std::map<int64_t, ElFrame> m_elFrames; // by display pts
+  int64_t m_lastJobPts{INT64_MIN}; // last frame the kernel asked for
+  int m_noPairLogged{0};           // since start or the last seek
+
+  std::thread m_elThread;
+  std::thread m_gpuThread;
+
+  // statistics
+  std::atomic<uint64_t> m_composed{0};
+  std::atomic<uint64_t> m_passthrough{0};
+  std::atomic<uint64_t> m_elDecoded{0};
+  double m_gpuMsSum{0};
+};
