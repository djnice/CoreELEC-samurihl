+// blue noise dither to 10 bits from the CoreELEC setting; /storage/dvfel_dither
+// overrides it for tests: 0 off, 1 on, 2 left half only. Read about once a second
+int DitherMode()
+{
+  std::ifstream f("/storage/dvfel_dither");
+  int v = -1;
+  if (f)
+    f >> v;
+  if (v >= 0 && v <= 2)
+    return v;
+  return CServiceBroker::GetSettingsComponent()->GetSettings()->GetBool(
+             CSettings::SETTING_COREELEC_AMLOGIC_DVFEL_DITHER)
+             ? 1
+             : 0;
+}
+
+// /storage/dvfel_pattern: 1 shows a 12-bit grey ramp test pattern
+int PatternMode()
+{
+  std::ifstream f("/storage/dvfel_pattern");
+  int v = 0;
+  if (f)
+    f >> v;
+  return v == 1 ? 1 : 0;
+}
+
+void DumpFrame(const AVFrame* el, const felgpu_meta& m)
+{
+  std::ofstream y("/storage/dvfel_el.yuv", std::ios::binary);
+  for (int p = 0; p < 3; p++)
+  {
+    const int w = p ? el->width / 2 : el->width, h = p ? el->height / 2 : el->height;
+    for (int r = 0; r < h; r++)
+      y.write(reinterpret_cast<const char*>(el->data[p] + r * el->linesize[p]), w * 2);
+  }
+  std::ofstream t("/storage/dvfel_meta.txt");
+  t.precision(12);
+  t << "bl " << m.bl_bits << " el " << m.el_bits << " use_el " << m.use_el << "\n";
+  for (int c = 0; c < 3; c++)
+  {
+    t << "comp " << c << " pivots";
+    for (int i = 0; i < m.npiv[c]; i++)
+      t << " " << m.pivots[c][i];
+    t << "\n";
+    for (int k = 0; k < m.npiv[c] - 1; k++)
+    {
+      t << "  piece " << k << " map " << m.mapping[c][k] << " poly " << m.poly[c][k][0] << " "
+        << m.poly[c][k][1] << " " << m.poly[c][k][2] << " mmr_order " << m.mmr_order[c][k]
+        << " const " << m.mmr_const[c][k] << " mmr";
+      for (int o = 0; o < m.mmr_order[c][k]; o++)
+        for (int j = 0; j < 7; j++)
+          t << " " << m.mmr[c][k][o][j];
+      t << "\n";
+    }
+    t << "  nlq offset " << m.nlq_offset[c] << " slope " << m.nlq_slope[c] << " thresh "
+      << m.nlq_thresh[c] << " max " << m.nlq_max[c] << "\n";
+  }
+}
+
+// HEVC NAL unit types of an Annex-B access unit: the first slice's type
+// (-1 without slices) and whether it ends a coded video sequence
+void ScanNals(const std::vector<uint8_t>& au, int& vclType, bool& endOfSeq)
+{
+  vclType = -1;
+  endOfSeq = false;
+  for (size_t i = 0; i + 4 < au.size(); i++)
+  {
+    if (au[i] != 0 || au[i + 1] != 0 || au[i + 2] != 1)
+      continue;
+    // like FFmpeg, skip invalid NAL units (forbidden bit, temporal id 0)
+    // and other layers; some EL tracks carry such stray units
+    const uint8_t h0 = au[i + 3], h1 = au[i + 4];
+    const int layer = ((h0 & 1) << 5) | (h1 >> 3);
+    if ((h0 & 0x80) || layer != 0 || (h1 & 7) == 0)
+    {
+      i += 3;
+      continue;
+    }
+    const int type = (h0 >> 1) & 0x3f;
+    if (type < 32 && vclType < 0)
+      vclType = type;
+    else if (type == 36 || type == 37) // end of sequence / bitstream
+      endOfSeq = true;
+    i += 3;
+  }
+}
+
+// std::map lookup of the entry closest to pts, within the tolerance
+template<typename T>
+typename std::map<int64_t, T>::iterator FindPts(std::map<int64_t, T>& m, int64_t pts)
+{
+  auto it = m.lower_bound(pts - PTS_TOLERANCE_US);
+  if (it != m.end() && std::llabs(it->first - pts) <= PTS_TOLERANCE_US)
+    return it;
+  return m.end();
+}
