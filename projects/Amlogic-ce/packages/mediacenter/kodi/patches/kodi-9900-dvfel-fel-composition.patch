+CAMLDvFel::~CAMLDvFel()
+{
+  Stop();
+}
+
+bool CAMLDvFel::IsAvailable()
+{
+  return access(DVFEL_DEV, R_OK | W_OK) == 0;
+}
+
+void CAMLDvFel::RouteThroughDvfel(bool enable)
+{
+  // non Dolby Vision decoding builds its map from vdec_vfm_path, Dolby Vision
+  // decoding (provider dvbldec) uses the static dvblpath map
+  WriteSysfs("/sys/class/vdec/vdec_vfm_path", enable ? "dvfel amlvideo deinterlace amvideo" : "disable");
+  WriteSysfs("/sys/class/vfm/map", "rm dvblpath");
+  WriteSysfs("/sys/class/vfm/map", enable ? "add dvblpath dvbldec dvfel amlvideo deinterlace amvideo"
+                                          : "add dvblpath dvbldec amlvideo deinterlace amvideo");
+}
+
+bool CAMLDvFel::Start(int width, int height)
+{
+  if (m_started)
+    return true;
+  if (width <= 0 || height <= 0 || (width & 3) || (height & 3))
+    return false;
+
+  m_width = width;
+  m_height = height;
+  m_stop = false;
+  m_noPairLogged = 0;
+
+  std::promise<bool> ready;
+  std::future<bool> ok = ready.get_future();
+  m_gpuThread = std::thread(&CAMLDvFel::GpuThread, this, std::move(ready));
+  if (!ok.get())
+  {
+    m_gpuThread.join();
+    CLog::Log(LOGERROR, "CAMLDvFel: GPU compositor failed to start, FEL composition disabled");
+    return false;
+  }
+  m_elThread = std::thread(&CAMLDvFel::ElThread, this);
+
+  RouteThroughDvfel(true);
+  m_started = true;
+  CLog::Log(LOGINFO, "CAMLDvFel: FEL composition started for {}x{}", width, height);
+  return true;
+}
+
+void CAMLDvFel::Stop()
+{
+  if (!m_started && !m_gpuThread.joinable())
+    return;
+
+  m_stop = true;
+  m_elCond.notify_all();
+  m_readyCond.notify_all();
+  if (m_elThread.joinable())
+    m_elThread.join();
+  if (m_gpuThread.joinable())
+    m_gpuThread.join();
+
+  if (m_started)
+  {
+    RouteThroughDvfel(false);
+    const uint64_t n = m_composed;
+    CLog::Log(LOGINFO,
+              "CAMLDvFel: stopped, {} frames composed (gpu avg {:.1f} ms), {} shown without EL, "
+              "{} EL frames decoded",
+              n, n ? m_gpuMsSum / n : 0.0, m_passthrough.load(), m_elDecoded.load());
+  }
+
+  std::lock_guard<std::mutex> lock(m_lock);
+  for (auto& f : m_elFrames)
+    av_frame_free(&f.second.frame);
+  m_elFrames.clear();
+  m_elQueue.clear();
+  m_started = false;
+}
+
+void CAMLDvFel::Reset()
+{
+  std::lock_guard<std::mutex> lock(m_lock);
+  m_elQueue.clear();
+  m_elQueue.push_back({0, {}, nullptr, true});
+  m_lastJobPts = INT64_MIN;
+  m_noPairLogged = 0;
+  m_pendingRpu.clear();
+  m_pendingEl.clear();
+  m_elCond.notify_all();
+}
+
+void CAMLDvFel::OnDoviRpu(const uint8_t* nal, uint32_t size)
+{
+  m_pendingRpu.assign(nal, nal + size);
+}
+
+void CAMLDvFel::OnDoviElNal(const uint8_t* nal, uint32_t size)
+{
+  static const uint8_t startCode[] = {0, 0, 0, 1};
+  m_pendingEl.insert(m_pendingEl.end(), startCode, startCode + 4);
+  m_pendingEl.insert(m_pendingEl.end(), nal, nal + size);
+}
+
+void CAMLDvFel::DropPacket()
+{
+  m_pendingRpu.clear();
+  m_pendingEl.clear();
+}
+
+void CAMLDvFel::CommitPacket(double pts)
+{
+  if (!m_started || pts < 0)
+  {
+    DropPacket();
+    return;
+  }
+  // the decoder reports the packet pts truncated to microseconds
+  const int64_t key = static_cast<int64_t>(pts);
+
+  std::shared_ptr<felgpu_meta> meta;
+  if (!m_pendingRpu.empty())
+    meta = ParseRpu(m_pendingRpu.data(), m_pendingRpu.size(), m_lastMeta);
+  if (meta)
+    m_lastMeta = meta;
+
+  std::lock_guard<std::mutex> lock(m_lock);
+  if (!m_pendingEl.empty() && m_elQueue.size() < MAX_EL_QUEUE)
+  {
+    m_elQueue.push_back({key, std::move(m_pendingEl), meta, false});
+    m_elCond.notify_all();
+  }
+  m_pendingEl.clear();
+  m_pendingRpu.clear();
+}
+
+void CAMLDvFel::ElThread()
+{
+  const AVCodec* codec = avcodec_find_decoder(AV_CODEC_ID_HEVC);
+  AVCodecContext* ctx = codec ? avcodec_alloc_context3(codec) : nullptr;
+  if (!ctx)
+    return;
+  ctx->thread_count = 3;
+  ctx->thread_type = FF_THREAD_FRAME;
+  if (avcodec_open2(ctx, codec, nullptr) < 0)
+  {
+    CLog::Log(LOGERROR, "CAMLDvFel: cannot open the EL decoder");
+    avcodec_free_context(&ctx);
+    return;
+  }
+  AVPacket* pkt = av_packet_alloc();
+  AVFrame* frame = av_frame_alloc();
+
+  // display order pairing: the pts of the packets whose EL pictures are in
+  // the decoder or were skipped, the metadata by packet pts, and how many
+  // skipped pictures still hold one of the earliest pts
+  std::multiset<int64_t> slots;
+  std::map<int64_t, std::shared_ptr<felgpu_meta>> metas;
+  int skipped = 0;
+  // Normally an EL picture belongs to the frame of the packet that carried
+  // it (frame->pts), which is immune to pictures FFmpeg drops and to odd
+  // packet timestamps. Once the carrying pts go backwards in output order,
+  // the EL is coded in another picture order than the base layer and the
+  // display order slots are used instead.
+  bool reordered = false;
+  int64_t lastLabel = INT64_MIN;
+  // after a flush FFmpeg needs an IRAP picture and drops the RASL pictures
+  // of a CRA it starts with; pictures FFmpeg drops never come out, so they
+  // are not sent either and give up their display slot. Both precede every
+  // picture that is output in display order.
+  bool needIrap = true, skipRasl = false;
+
+  while (!m_stop)
+  {
+    ElPacket in;
+    {
+      std::unique_lock<std::mutex> lock(m_lock);
+      // pace decoding by the display: stay at most EL_LEAD_US ahead of the
+      // last requested frame (before the first request: a few frames)
+      auto paced = [this] {
+        if (m_elFrames.size() >= MAX_EL_FRAMES)
+          return false;
+        if (m_lastJobPts == INT64_MIN)
+          return m_elFrames.size() < 12;
+        return m_elFrames.empty() || m_elFrames.rbegin()->first < m_lastJobPts + EL_LEAD_US;
+      };
+      m_elCond.wait(lock, [&] {
+        return m_stop || (!m_elQueue.empty() && (m_elQueue.front().flush || paced()));
+      });
+      if (m_stop)
+        break;
+      in = std::move(m_elQueue.front());
+      m_elQueue.pop_front();
+    }
+
+    if (in.flush)
+    {
+      avcodec_flush_buffers(ctx);
+      slots.clear();
+      metas.clear();
+      skipped = 0;
+      lastLabel = INT64_MIN;
+      needIrap = true;
+      skipRasl = false;
+      std::lock_guard<std::mutex> lock(m_lock);
+      for (auto& f : m_elFrames)
+        av_frame_free(&f.second.frame);
+      m_elFrames.clear();
+      continue;
+    }
+
+    int type;
+    bool endOfSeq;
+    ScanNals(in.data, type, endOfSeq);
+    if (type < 0)
+      continue;
+    bool decode = true;
+    if (type >= 16 && type <= 23) // IRAP: BLA 16-18, IDR 19-20, CRA 21
+    {
+      skipRasl = type <= 18 || (type == 21 && needIrap);
+      needIrap = false;
+    }
+    else if (needIrap || (skipRasl && (type == 8 || type == 9)))
+    {
+      decode = false;
+    }
+    if (endOfSeq)
+      needIrap = true;
+
+    slots.insert(in.pts);
+    if (!decode)
+    {
+      skipped++;
+      continue;
+    }
+    metas[in.pts] = std::move(in.meta);
+    while (metas.size() > 2 * MAX_EL_FRAMES) // never output, e.g. broken pictures
+      metas.erase(metas.begin());
+
+    if (av_new_packet(pkt, static_cast<int>(in.data.size())) < 0)
+      continue;
+    std::memcpy(pkt->data, in.data.data(), in.data.size());
+    pkt->pts = in.pts;
+    int ret = avcodec_send_packet(ctx, pkt);
+    av_packet_unref(pkt);
+    if (ret < 0 && ret != AVERROR(EAGAIN))
+      continue;
+
+    while (avcodec_receive_frame(ctx, frame) == 0)
+    {
+      for (; skipped > 0 && !slots.empty(); skipped--)
+        slots.erase(slots.begin());
+      if (slots.empty())
+      {
+        av_frame_unref(frame);
+        continue;
+      }
+      // output is in display order: the earliest pts is this picture's slot
+      const int64_t slot = *slots.begin();
+      slots.erase(slots.begin());
+      // frame->pts is the pts of the packet that carried the picture
+      if (!reordered && lastLabel != INT64_MIN && frame->pts < lastLabel)
+      {
+        reordered = true;
+        CLog::Log(LOGINFO,
+                  "CAMLDvFel: the EL picture order differs from the base layer, pairing by "
+                  "display order");
+        // what was filed by the carrying pts from here on is misplaced
+        std::lock_guard<std::mutex> lock(m_lock);
+        for (auto it = m_elFrames.lower_bound(slot); it != m_elFrames.end();)
+        {
+          av_frame_free(&it->second.frame);
+          it = m_elFrames.erase(it);
+        }
+      }
+      lastLabel = frame->pts;
+      const int64_t pts = reordered ? slot : frame->pts;
+      std::shared_ptr<felgpu_meta> meta;
+      auto m = metas.find(frame->pts);
+      if (m != metas.end())
+      {
+        meta = std::move(m->second);
+        metas.erase(m);
+      }
+      if (!meta || frame->format != AV_PIX_FMT_YUV420P10 || frame->width * 2 != m_width ||
+          frame->height * 2 != m_height)
+      {
+        av_frame_unref(frame);
+        continue;
+      }
+      AVFrame* keep = av_frame_clone(frame);
+      av_frame_unref(frame);
+      keep->pts = pts;
+      std::lock_guard<std::mutex> lock(m_lock);
+      // only frames the display has passed may go; never drop a future one
+      while (m_lastJobPts != INT64_MIN && m_elFrames.size() >= MAX_EL_FRAMES &&
+             m_elFrames.begin()->first < m_lastJobPts - PTS_TOLERANCE_US)
+      {
+        av_frame_free(&m_elFrames.begin()->second.frame);
+        m_elFrames.erase(m_elFrames.begin());
+      }
+      auto& entry = m_elFrames[pts];
+      if (entry.frame)
+        av_frame_free(&entry.frame);
+      entry = {keep, std::move(meta)};
+      m_elDecoded++;
+      m_readyCond.notify_all();
+    }
+  }
+
+  av_frame_free(&frame);
+  av_packet_free(&pkt);
+  avcodec_free_context(&ctx);
+}
+
+bool CAMLDvFel::WaitForFrame(int64_t pts, AVFrame*& frame, std::shared_ptr<felgpu_meta>& meta)
+{
+  std::unique_lock<std::mutex> lock(m_lock);
+  // the display reached pts: let the paced EL decoder run ahead of it
+  m_lastJobPts = pts;
+  while (!m_elFrames.empty() && m_elFrames.begin()->first < pts - PTS_TOLERANCE_US)
+  {
+    av_frame_free(&m_elFrames.begin()->second.frame);
+    m_elFrames.erase(m_elFrames.begin());
+  }
+  m_elCond.notify_all();
+
+  const bool found = m_readyCond.wait_for(lock, std::chrono::milliseconds(EL_WAIT_MS), [&] {
+    return m_stop || FindPts(m_elFrames, pts) != m_elFrames.end();
+  });
+  if (!found || m_stop)
+  {
+    if (!m_stop && m_noPairLogged < 10)
+    {
+      m_noPairLogged++;
+      auto el = m_elFrames.lower_bound(pts);
+      CLog::Log(LOGINFO, "CAMLDvFel: no EL for pts {} us: EL frames {} [{}..{}] next {}, EL queue {}",
+                pts, m_elFrames.size(), m_elFrames.empty() ? 0 : m_elFrames.begin()->first,
+                m_elFrames.empty() ? 0 : m_elFrames.rbegin()->first,
+                el == m_elFrames.end() ? -1 : el->first, m_elQueue.size());
+    }
+    return false;
+  }
+
+  auto f = FindPts(m_elFrames, pts);
+  frame = av_frame_clone(f->second.frame);
+  meta = f->second.meta;
+
+  // everything older is not needed any more
+  for (auto it = m_elFrames.begin(); it != f;)
+  {
+    av_frame_free(&it->second.frame);
+    it = m_elFrames.erase(it);
+  }
+  return frame != nullptr;
+}
+
+void CAMLDvFel::GpuThread(std::promise<bool> ready)
+{
+  bool announced = false;
+  auto fail = [&](const char* what) {
+    CLog::Log(LOGERROR, "CAMLDvFel: {}", what);
+    if (!announced)
+      ready.set_value(false);
+    announced = true;
+  };
+
+  int dev = -1, heap = -1, drm = -1;
+  struct gbm_device* gbm = nullptr;
+  EGLDisplay dpy = EGL_NO_DISPLAY;
+  EGLContext ctx = EGL_NO_CONTEXT;
+  struct felgpu* fel = nullptr;
+  dvfel_reg_bufs reg{};
+  GLuint tin[GPU_BUFFERS]{}, tout[GPU_BUFFERS]{}, fout[GPU_BUFFERS]{};
+  EGLImageKHR images[GPU_BUFFERS * 2]{};
+  int nimg = 0;
+
+  auto createImage = PFNEGLCREATEIMAGEKHRPROC(eglGetProcAddress("eglCreateImageKHR"));
+  auto destroyImage = PFNEGLDESTROYIMAGEKHRPROC(eglGetProcAddress("eglDestroyImageKHR"));
+  auto targetTexture =
+      PFNGLEGLIMAGETARGETTEXTURE2DOESPROC(eglGetProcAddress("glEGLImageTargetTexture2DOES"));
+  auto importTex = [&](int fd) -> GLuint {
+    const EGLint attr[] = {EGL_WIDTH, m_width, EGL_HEIGHT, m_height,
+                           EGL_LINUX_DRM_FOURCC_EXT, DRM_FORMAT_ABGR8888,
+                           EGL_DMA_BUF_PLANE0_FD_EXT, fd,
+                           EGL_DMA_BUF_PLANE0_OFFSET_EXT, 0,
+                           EGL_DMA_BUF_PLANE0_PITCH_EXT, m_width * 4,
+                           EGL_NONE};
+    EGLImageKHR img = createImage(dpy, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attr);
+    if (img == EGL_NO_IMAGE_KHR)
+      return 0;
+    images[nimg++] = img;
+    GLuint tex;
+    glGenTextures(1, &tex);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    targetTexture(GL_TEXTURE_2D, img);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    return glGetError() == GL_NO_ERROR ? tex : 0;
+  };
+
+  do
+  {
+    if (!createImage || !destroyImage || !targetTexture)
+    {
+      fail("EGL image extensions missing");
+      break;
+    }
+    drm = open("/dev/dri/renderD128", O_RDWR | O_CLOEXEC);
+    gbm = drm >= 0 ? gbm_create_device(drm) : nullptr;
+    auto getPlatformDisplay =
+        PFNEGLGETPLATFORMDISPLAYEXTPROC(eglGetProcAddress("eglGetPlatformDisplayEXT"));
+    if (!gbm || !getPlatformDisplay)
+    {
+      fail("no GBM render device");
+      break;
+    }
+    dpy = getPlatformDisplay(EGL_PLATFORM_GBM_KHR, gbm, nullptr);
+    EGLint maj, min;
+    if (dpy == EGL_NO_DISPLAY || !eglInitialize(dpy, &maj, &min))
+    {
+      fail("eglInitialize failed");
+      break;
+    }
+    eglBindAPI(EGL_OPENGL_ES_API);
+    const EGLint ctxAttr[] = {EGL_CONTEXT_MAJOR_VERSION, 3, EGL_CONTEXT_MINOR_VERSION, 2, EGL_NONE};
+    ctx = eglCreateContext(dpy, EGL_NO_CONFIG_KHR, EGL_NO_CONTEXT, ctxAttr);
+    if (ctx == EGL_NO_CONTEXT || !eglMakeCurrent(dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, ctx))
+    {
+      fail("cannot create a surfaceless GLES 3.2 context");
+      break;
+    }
+
+    fel = felgpu_create(m_width, m_height, EL_TAPS);
+    if (!fel)
+    {
+      fail("felgpu_create failed");
+      break;
+    }
+
+    dev = open(DVFEL_DEV, O_RDWR | O_CLOEXEC);
+    heap = open("/dev/dma_heap/heap-codecmm", O_RDWR | O_CLOEXEC);
+    if (dev < 0 || heap < 0)
+    {
+      fail("cannot open /dev/dvfel or the codec_mm dma heap");
+      break;
+    }
+    reg.width = m_width;
+    reg.height = m_height;
+    reg.count = GPU_BUFFERS;
+    bool ok = true;
+    for (int i = 0; i < GPU_BUFFERS && ok; i++)
+    {
+      for (int o = 0; o < 2 && ok; o++)
+      {
+        dma_heap_allocation_data a{};
+        a.len = DVFEL_BUF_SIZE(m_width, m_height);
+        a.fd_flags = O_RDWR | O_CLOEXEC;
+        ok = ioctl(heap, DMA_HEAP_IOCTL_ALLOC, &a) == 0;
+        if (ok)
+          (o ? reg.out_fd : reg.in_fd)[i] = a.fd;
+      }
+      if (ok)
+      {
+        tin[i] = importTex(reg.in_fd[i]);
+        tout[i] = importTex(reg.out_fd[i]);
+        ok = tin[i] && tout[i];
+      }
+      if (ok)
+      {
+        glGenFramebuffers(1, &fout[i]);
+        glBindFramebuffer(GL_FRAMEBUFFER, fout[i]);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tout[i], 0);
+        ok = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+      }
+    }
+    if (!ok)
+    {
+      fail("cannot allocate or import the frame buffers");
+      break;
+    }
+    glFinish();
+    if (ioctl(dev, DVFEL_IOC_REG_BUFS, &reg) < 0)
+    {
+      fail("DVFEL_IOC_REG_BUFS failed");
+      break;
+    }
+    ready.set_value(true);
+    announced = true;
+    CLog::Log(LOGINFO, "CAMLDvFel: GPU compositor ready ({})",
+              reinterpret_cast<const char*>(glGetString(GL_RENDERER)));
+
+    std::shared_ptr<felgpu_meta> current;
+    const int64_t dumpPts = DumpPts();
+    int dither = -1, pattern = -1;
+    auto nextDitherCheck = std::chrono::steady_clock::now();
+    while (!m_stop)
+    {
+      if (std::chrono::steady_clock::now() >= nextDitherCheck)
+      {
+        nextDitherCheck += std::chrono::seconds(1);
+        const int mode = DitherMode();
+        if (mode != dither)
+        {
+          dither = mode;
+          felgpu_set_dither(fel, mode);
+          CLog::Log(LOGINFO, "CAMLDvFel: dither mode {}", mode);
+        }
+        const int pat = PatternMode();
+        if (pat != pattern)
+        {
+          pattern = pat;
+          felgpu_set_pattern(fel, pat);
+          CLog::Log(LOGINFO, "CAMLDvFel: test pattern {}", pat);
+        }
+      }
+
+      dvfel_job job{};
+      job.timeout_ms = 100;
+      if (ioctl(dev, DVFEL_IOC_WAIT_JOB, &job) < 0)
+      {
+        if (errno == ETIMEDOUT || errno == EINTR)
+          continue;
+        CLog::Log(LOGERROR, "CAMLDvFel: DVFEL_IOC_WAIT_JOB failed: {}", strerror(errno));
+        break;
+      }
+
+      dvfel_job_done done{};
+      done.id = job.id;
+      done.status = DVFEL_DONE_PASSTHROUGH;
+
+      AVFrame* el = nullptr;
+      std::shared_ptr<felgpu_meta> meta;
+      if (job.buf < GPU_BUFFERS && WaitForFrame(static_cast<int64_t>(job.pts_us), el, meta))
+      {
+        const auto t0 = std::chrono::steady_clock::now();
+        if (dumpPts >= 0 && static_cast<int64_t>(job.pts_us) == dumpPts)
+        {
+          DumpFrame(el, *meta);
+          CLog::Log(LOGINFO, "CAMLDvFel: dumped EL frame pts {} (EL frame pts {})", dumpPts, el->pts);
+        }
+        if (meta != current)
+        {
+          felgpu_set_meta(fel, meta.get());
+          current = meta;
+        }
+        felgpu_set_el(fel, reinterpret_cast<const uint16_t*>(el->data[0]), el->linesize[0] / 2,
+                      reinterpret_cast<const uint16_t*>(el->data[1]),
+                      reinterpret_cast<const uint16_t*>(el->data[2]), el->linesize[1] / 2);
+        felgpu_run(fel, tin[job.buf], fout[job.buf]);
+        glFinish();
+        m_gpuMsSum += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        done.status = DVFEL_DONE_COMPOSED;
+        m_composed++;
+      }
+      else
+      {
+        m_passthrough++;
+      }
+      av_frame_free(&el);
+      ioctl(dev, DVFEL_IOC_JOB_DONE, &done);
+    }
+  } while (false);
+
+  if (dev >= 0)
+  {
+    ioctl(dev, DVFEL_IOC_UNREG_BUFS);
+    close(dev);
+  }
+  if (fel)
+    felgpu_destroy(fel);
+  if (ctx != EGL_NO_CONTEXT)
+  {
+    glDeleteFramebuffers(GPU_BUFFERS, fout);
+    glDeleteTextures(GPU_BUFFERS, tin);
+    glDeleteTextures(GPU_BUFFERS, tout);
+    for (int i = 0; i < nimg; i++)
+      destroyImage(dpy, images[i]);
+    eglMakeCurrent(dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    eglDestroyContext(dpy, ctx);
+  }
+  if (dpy != EGL_NO_DISPLAY)
+    eglTerminate(dpy);
+  for (int i = 0; i < GPU_BUFFERS; i++)
+  {
+    if (reg.in_fd[i] > 0)
+      close(reg.in_fd[i]);
+    if (reg.out_fd[i] > 0)
+      close(reg.out_fd[i]);
+  }
+  if (heap >= 0)
+    close(heap);
+  if (gbm)
+    gbm_device_destroy(gbm);
+  if (drm >= 0)
+    close(drm);
+  if (!announced)
+    ready.set_value(false);
+}
